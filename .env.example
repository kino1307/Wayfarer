# BYOK: users supply their own Anthropic key in the UI (stored in their browser only).
# The server never reads an Anthropic key from the environment — do NOT put one here.
PORT=3013

# Comma-separated origins allowed to call the API (CORS). Add your deploy origin here.
ALLOWED_ORIGINS=http://localhost:5173

# Optional: override the client's API base URL (leave empty for local dev proxy / same-origin).
VITE_API_BASE=

# Optional: pre-fill the API key in the UI (leave empty to require manual entry).
# NEVER set this to a real key — VITE_* vars are inlined into the public client bundle.
VITE_DEFAULT_API_KEY=

# Optional, server-side only: enables the Gemini Flash benchmark model options
# (gemini:gemini-2.0-flash / gemini:gemini-2.5-flash). Leave empty to disable them.
GEMINI_API_KEY=
